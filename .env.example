# Copy this file to `.env` and fill in your eupowerprices API key.
#
#   cp .env.example .env
#
# The `.env` file is gitignored and is used ONLY by `dryrun.py` for local
# testing. The Home Assistant component reads no `.env` — you enter the API
# key in the integration's setup screen instead. Never commit `.env`.
EUPOWERPRICES_API_KEY=